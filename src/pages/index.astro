		<script>
			// Мобільне меню
			const menuToggle = document.getElementById('menu-toggle');
			const navList = document.getElementById('nav-list');
			const header = document.querySelector('.header');
			if (menuToggle && navList) {
				menuToggle.addEventListener('click', () => {
					const isOpen = navList.classList.contains('is-open');
					navList.classList.toggle('is-open');
					menuToggle.setAttribute('aria-label', isOpen ? 'Відкрити меню' : 'Закрити меню');
				});

				navList.querySelectorAll('a[href^="#"]').forEach((link) => {
					link.addEventListener('click', () => {
						navList.classList.remove('is-open');
						menuToggle.setAttribute('aria-label', 'Відкрити меню');
					});
				});
			}

			let headerLastScrollY = window.scrollY;
			const headerShowThreshold = 12;
			const syncHeaderOnScroll = () => {
				if (!header) return;
				const currentScrollY = window.scrollY;
				const isScrolled = currentScrollY > 24;
				header.classList.toggle('is-scrolled', isScrolled);

				if (currentScrollY <= 8) {
					header.classList.remove('is-hidden');
					headerLastScrollY = currentScrollY;
					return;
				}

				const delta = currentScrollY - headerLastScrollY;
				const isMenuOpen = navList?.classList.contains('is-open');
				if (!isMenuOpen && delta > headerShowThreshold) {
					header.classList.add('is-hidden');
				} else if (delta < -headerShowThreshold) {
					header.classList.remove('is-hidden');
				}

				headerLastScrollY = currentScrollY;
			};

			syncHeaderOnScroll();
			window.addEventListener('scroll', syncHeaderOnScroll, { passive: true });

			const faqItems = document.querySelectorAll('.faq-item');
			if (faqItems.length) {
				faqItems.forEach((item) => {
					item.addEventListener('click', () => {
						const isOpen = item.classList.contains('is-open');
						faqItems.forEach((other) => {
							other.classList.remove('is-open');
							other.setAttribute('aria-expanded', 'false');
						});
						if (!isOpen) {
							item.classList.add('is-open');
							item.setAttribute('aria-expanded', 'true');
						}
					});
				});
			}

			// Blur for process cards (.process-row) based on scroll position
			(() => {
				const prefersReducedMotion = window.matchMedia?.('(prefers-reduced-motion: reduce)')?.matches;
				if (prefersReducedMotion) return;

				const sections = Array.from(document.querySelectorAll<HTMLElement>('#process'));
				const rows = sections.flatMap((section) =>
					Array.from(section.querySelectorAll<HTMLElement>('.process-row'))
				);
				if (!rows.length) return;

				const clamp = (v: number, min: number, max: number) => Math.max(min, Math.min(max, v));

				let raf = 0;
				const update = () => {
					raf = 0;
					const viewportCenter = window.innerHeight / 2;
					// Start blurring only below this viewport Y (lower than center)
					const blurStartY = window.innerHeight * 0.65;
					// Classic: 0px at center, grows with distance
					const falloff = 320; // px
					const maxBlur = 6; // px

					rows.forEach((row) => {
						const rect = row.getBoundingClientRect();
						// Ignore hidden/offscreen rows (e.g. hidden light section) to avoid wrong reads
						if (rect.width === 0 || rect.height === 0) return;
						if (rect.bottom < 0 || rect.top > window.innerHeight) return;

						const center = rect.top + rect.height / 2;
						// Only blur the part below the viewport center (top stays sharp)
						const below = Math.max(0, center - blurStartY);
						const t = clamp(below / falloff, 0, 1);
						const blur = t * maxBlur;
						row.style.setProperty('--process-card-blur', `${blur.toFixed(2)}px`);
					});
				};

				const schedule = () => {
					if (raf) return;
					raf = window.requestAnimationFrame(update);
				};

				update();
				window.addEventListener('scroll', schedule, { passive: true });
				window.addEventListener('resize', schedule);
			})();

			// Single sticky media for "My services" (scroll-driven preview)
			(() => {
				const prefersReducedMotion = window.matchMedia?.('(prefers-reduced-motion: reduce)')?.matches;
				const media = document.querySelector<HTMLElement>('[data-my-services-media]');
				const mediaImg = media?.querySelector<HTMLImageElement>('.my-services-media-img') ?? null;
				const items = Array.from(document.querySelectorAll<HTMLElement>('#my-services .my-service'));
				if (!media || !items.length) return;

				let raf = 0;

				const setVisible = (visible: boolean) => {
					media.classList.toggle('is-visible', visible);
					media.classList.toggle('is-hidden', !visible);
				};

				const setImage = (item: HTMLElement | null) => {
					if (!mediaImg || !item) return;
					const next = item.getAttribute('data-my-service-image');
					if (!next || mediaImg.getAttribute('src') === next) return;
					mediaImg.setAttribute('src', next);
				};

				const update = () => {
					raf = 0;
					const triggerY = Math.round(window.innerHeight * 0.3); // ~30% from top
					const viewportH = window.innerHeight;

					let activeItem: HTMLElement | null = null;
					let bestDelta = Number.POSITIVE_INFINITY;

					items.forEach((item) => {
						const rect = item.getBoundingClientRect();
						// consider only items that intersect viewport at all
						if (rect.bottom < 0 || rect.top > viewportH) return;

						// "centered" item heuristic
						const center = rect.top + rect.height / 2;
						const delta = Math.abs(center - viewportH / 2);

						// Reveal when item crosses ~30% line, and keep visible while media fits inside the item
						const mediaH = media.getBoundingClientRect().height || 0;
						const crossesTrigger = rect.top <= triggerY && rect.bottom >= triggerY;
						const canFit = rect.bottom >= triggerY + mediaH;
						if (!crossesTrigger || !canFit) return;

						if (delta < bestDelta) {
							bestDelta = delta;
							activeItem = item;
						}
					});

					if (!activeItem) {
						setVisible(prefersReducedMotion ? true : false);
						return;
					}

					setVisible(true);
					setImage(activeItem);
					items.forEach((item) => item.classList.toggle('is-active', item === activeItem));
				};

				const schedule = () => {
					if (raf) return;
					raf = window.requestAnimationFrame(update);
				};

				// initial
				setVisible(prefersReducedMotion ? true : false);
				update();
				window.addEventListener('scroll', schedule, { passive: true });
				window.addEventListener('resize', schedule);
			})();

			const processItems = document.querySelectorAll('.process-item[data-step]');
			const processPanels = document.querySelectorAll('.process-preview-panel[data-step-panel]');
			if (processItems.length && processPanels.length) {
				const processSection = document.getElementById('process');
				const processPreview = document.querySelector('.process-preview');
				const items = Array.from(processItems);
				const panels = Array.from(processPanels);
				const firstPanel = panels[0];
				const lastPanel = panels[panels.length - 1];
				let activeStep = '1';
				const triggerRatio = 0.7; // switch when item reaches lower-mid viewport
				const startEdgeToggleOffset = 150; // px to scroll before start edge hide/show toggles
				const endEdgeToggleOffset = 450; // px to scroll before end edge hide/show toggles
				let lastScrollY = window.scrollY;
				let isStartHidden = true;
				let isEndHidden = false;

				if (processPreview) {
					processPreview.classList.add('is-start-hidden');
				}

				const setProcessStep = (step, direction = 'down') => {
					if (!step || step === activeStep) return;
					activeStep = step;

					items.forEach((item) => {
						const isActive = item.getAttribute('data-step') === step;
						item.classList.toggle('is-active', isActive);
					});

					panels.forEach((panel) => {
						const isActive = panel.getAttribute('data-step-panel') === step;
						panel.classList.toggle('is-active', isActive);
						panel.classList.remove('is-forward', 'is-reverse');
						if (isActive) {
							panel.classList.add(direction === 'up' ? 'is-reverse' : 'is-forward');
						}
					});
				};

				const triggerPanelReveal = (panel, direction) => {
					if (!panel) return;
					panel.classList.remove('is-forward', 'is-reverse');
					// Force animation restart when toggling hidden state
					void panel.offsetWidth;
					panel.classList.add(direction === 'up' ? 'is-reverse' : 'is-forward');
				};

				const syncEdgeProcessImageVisibility = (direction) => {
					if (!processSection || !processPreview) return;
					const sectionRect = processSection.getBoundingClientRect();
					const scrolledInsideSection = Math.max(0, -sectionRect.top);
					const scrolledPastSection = Math.max(0, window.innerHeight - sectionRect.bottom);
					const shouldHideStart = scrolledInsideSection < startEdgeToggleOffset;
					const shouldHideEnd = scrolledPastSection > endEdgeToggleOffset;

					if (shouldHideStart !== isStartHidden) {
						isStartHidden = shouldHideStart;
						processPreview.classList.toggle('is-start-hidden', shouldHideStart);
						if (!shouldHideStart) triggerPanelReveal(firstPanel, direction);
					}

					if (shouldHideEnd !== isEndHidden) {
						isEndHidden = shouldHideEnd;
						processPreview.classList.toggle('is-end-hidden', shouldHideEnd);
						if (!shouldHideEnd) triggerPanelReveal(lastPanel, direction);
					}
				};

				const updateStepOnScroll = () => {
					const currentScrollY = window.scrollY;
					const direction = currentScrollY < lastScrollY ? 'up' : 'down';
					lastScrollY = currentScrollY;
					syncEdgeProcessImageVisibility(direction);
					const viewportAnchor = window.innerHeight * triggerRatio;
					const lastItem = items[items.length - 1];

					// Lock to the 5th step exactly when it reaches viewport center.
					if (lastItem) {
						const lastRect = lastItem.getBoundingClientRect();
						if (lastRect.top <= viewportAnchor) {
							const lastStep = lastItem.getAttribute('data-step');
							if (lastStep) setProcessStep(lastStep, direction);
							return;
						}
					}

					let currentItem = items[0];
					items.forEach((item) => {
						const rect = item.getBoundingClientRect();
						if (rect.top <= viewportAnchor) currentItem = item;
					});

					const step = currentItem.getAttribute('data-step');
					if (step) setProcessStep(step, direction);
				};

				updateStepOnScroll();
				window.addEventListener('scroll', updateStepOnScroll, { passive: true });
				window.addEventListener('resize', updateStepOnScroll);
			}

			const modalOverlay = document.querySelector('.modal-overlay[data-modal-overlay="contact-modal"]');
			const modalTriggers = document.querySelectorAll('[data-open-modal="contact-modal"]');
			const modalCloseButtons = document.querySelectorAll('[data-close-modal]');
			const web3RedirectFields = document.querySelectorAll('input[name="redirect"][data-web3-redirect]');

			if (web3RedirectFields.length) {
				const redirectUrl = `${window.location.origin}/thank-you`;
				web3RedirectFields.forEach((field) => {
					field.value = redirectUrl;
				});
			}

			const openModal = () => {
				if (!modalOverlay) return;
				modalOverlay.classList.add('is-open');
				modalOverlay.setAttribute('aria-hidden', 'false');
			};

			const closeModal = () => {
				if (!modalOverlay) return;
				modalOverlay.classList.remove('is-open');
				modalOverlay.setAttribute('aria-hidden', 'true');
			};

			modalTriggers.forEach((trigger) => {
				trigger.addEventListener('click', (event) => {
					event.preventDefault();
					openModal();
				});
			});

			modalCloseButtons.forEach((button) => {
				button.addEventListener('click', () => {
					closeModal();
				});
			});

			modalOverlay?.addEventListener('click', (event) => {
				if (event.target === modalOverlay) {
					closeModal();
				}
			});

			window.addEventListener('keydown', (event) => {
				if (event.key === 'Escape') {
					closeModal();
				}
			});

			// Blur stack for process cards: blur fades out near viewport center.
			const processCards = Array.from(document.querySelectorAll('#process .process-row'));
			const reduceMotion = window.matchMedia?.('(prefers-reduced-motion: reduce)')?.matches;
			const isMobileProcess = window.matchMedia?.('(max-width: 56rem)')?.matches;
			if (processCards.length && !reduceMotion && !isMobileProcess) {
				const baseBlurByIndex = [0, 0.6, 1.2, 2.1, 3.2];
				const updateProcessCardBlur = () => {
					const viewportCenter = window.innerHeight * 0.5;
					const blurDistance = window.innerHeight * 0.44;

					processCards.forEach((card, index) => {
						const rect = card.getBoundingClientRect();
						const cardCenter = rect.top + (rect.height / 2);
						// Blur only for cards below viewport center (bottom stack effect).
						const distanceBelowCenter = cardCenter - viewportCenter;
						const progress = Math.min(Math.max(distanceBelowCenter / blurDistance, 0), 1);
						const baseBlur = baseBlurByIndex[index] ?? 1.4;
						const blur = baseBlur * progress;

						card.style.setProperty('--process-card-blur', `${blur.toFixed(2)}px`);
					});
				};

				updateProcessCardBlur();
				window.addEventListener('scroll', updateProcessCardBlur, { passive: true });
				window.addEventListener('resize', updateProcessCardBlur);
			} else if (processCards.length) {
				processCards.forEach((card) => {
					card.style.setProperty('--process-card-blur', '0px');
				});
			}
		</script>
	</body>
</html>
