---
import '../styles/global.css';
---

<html lang="uk">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<meta name="description" content="Розробляю сайти на Webflow — лендинги, бізнес-сайти та багатосторінкові проєкти. Акуратна верстка, чітка структура, зрозумілий процес." />
		<meta name="generator" content={Astro.generator} />

		<!-- Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap" rel="stylesheet" />

		<!-- Favicon -->
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:title" content="Розробка сайтів на Webflow під ключ" />
		<meta property="og:description" content="Розробляю сайти на Webflow — лендинги, бізнес-сайти та багатосторінкові проєкти. Акуратна верстка, чітка структура, зрозумілий процес." />
		<meta property="og:image" content="/images/opnegraph-home-page.jpg" />
		<meta property="og:locale" content="uk_UA" />

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="Розробка сайтів на Webflow під ключ" />
		<meta name="twitter:description" content="Розробляю сайти на Webflow — лендинги, бізнес-сайти та багатосторінкові проєкти. Акуратна верстка, чітка структура, зрозумілий процес." />
		<meta name="twitter:image" content="/images/opnegraph-home-page.jpg" />

		<title>Розробка сайтів на Webflow під ключ</title>
	</head>
	<body>
		<header class="header">
			<nav class="nav container">
				<a href="/" class="logo"><img src="/images/logo-large.svg" alt="Webflow Dev" width="196" height="17" /></a>
				<ul class="nav-list" id="nav-list">
					<li><a href="#hero">Головна</a></li>
					<li><a href="#services">Послуги</a></li>
					<li><a href="#process">Процес</a></li>
					<li><a href="#work">Роботи</a></li>
					<li><a href="#about">Про мене</a></li>
					<li><a href="#blog">Блог</a></li>
					<li><a href="#contact">Контакт</a></li>
				</ul>
				<div class="nav-actions">
					<a href="#contact" class="btn btn-primary nav-cta">Обговорити проєкт</a>
					<button type="button" class="menu-toggle" aria-label="Відкрити меню" id="menu-toggle">
						<span></span>
						<span></span>
						<span></span>
					</button>
				</div>
			</nav>
		</header>

		<main>
			<section id="hero" class="hero">
				<div class="section-pad">
					<div class="container">
						<div class="section-content hero-content">
				<p class="hero-kicker">Webflow Developer</p>
				<h1 class="hero-title">Розробка сайтів на Webflow під ключ</h1>
				<h3 class="hero-text">
					Берусь за задачу, роблю, здаю. Все просто.
				</h3>
				<div class="hero-actions">
					<a href="#contact" class="btn btn-primary">Обговорити проєкт</a>
				</div>
						</div>
					</div>
				</div>
			</section>

			<section id="work" class="section work">
				<div class="section-pad">
					<div class="container">
						<div class="section-content work-section">
				<h2 class="work-heading">Проєкти</h2>
				<p class="section-intro work-intro">
					Роблю сайти на Webflow під ваш формат задачі: від лендингу до CMS-сайту.
				</p>

				<div class="work-preview-frame">
					<div class="work-preview-panel is-active" data-panel="landing">
						<img
							class="work-preview-image"
							src="/images/tab-content/original-e007cf174b7030ef3b9ece3cea0c69b1.webp"
							alt="Прев'ю лендингу"
							loading="lazy"
						/>
						<span>Лендинг з фокусом на заявку</span>
					</div>
					<div class="work-preview-panel" data-panel="business">
						<img
							class="work-preview-image"
							src="/images/tab-content/original-12c002c69215970cd2eaf4824b287a4f.webp"
							alt="Прев'ю бізнес-сайту"
							loading="lazy"
						/>
						<span>Багатосторінковий бізнес-сайт</span>
					</div>
					<div class="work-preview-panel" data-panel="cms">
						<img
							class="work-preview-image"
							src="/images/tab-content/original-1840e2de901619557990728c3e74a094.webp"
							alt="Прев'ю CMS-сайту"
							loading="lazy"
						/>
						<span>Сайт з CMS і блогом</span>
					</div>
					<div class="work-preview-panel" data-panel="redesign">
						<img
							class="work-preview-image"
							src="/images/tab-content/original-25a987b5055b056376f5d1a10fad76c2.webp"
							alt="Прев'ю редизайну"
							loading="lazy"
						/>
						<span>Редизайн і перенос на Webflow</span>
					</div>
				</div>

				<div class="work-types" role="tablist" aria-label="Типи сайтів">
					<button type="button" class="work-type is-active" data-tab="landing" role="tab" aria-selected="true">
						<span class="work-type-title">Лендинг</span>
						<span class="work-type-desc">Одна сторінка з фокусом на заявку, чіткою структурою і сильним CTA.</span>
					</button>
					<button type="button" class="work-type" data-tab="business" role="tab" aria-selected="false">
						<span class="work-type-title">Бізнес-сайт</span>
						<span class="work-type-desc">Багатосторінковий сайт для послуг, кейсів та зрозумілої навігації.</span>
					</button>
					<button type="button" class="work-type" data-tab="cms" role="tab" aria-selected="false">
						<span class="work-type-title">CMS-сайт</span>
						<span class="work-type-desc">Webflow CMS для блогу, новин або кейсів з простим оновленням контенту.</span>
					</button>
					<button type="button" class="work-type" data-tab="redesign" role="tab" aria-selected="false">
						<span class="work-type-title">Редизайн</span>
						<span class="work-type-desc">Оновлення структури і візуалу без хаосу, з перенесенням на Webflow.</span>
					</button>
				</div>
						</div>
					</div>
				</div>
			</section>

			<section id="services" class="section services">
				<div class="section-pad">
					<div class="container">
						<div class="section-content services-layout">
				<h2 class="services-heading">Від макету до запуску — все на Webflow</h2>
				<div class="services-grid">
					<article class="service-card">
						<div class="service-icon-slot" aria-hidden="true">
							<img class="service-icon-image" src="/images/icon/FigmaToWebflow%20%281%29%201.svg" alt="" loading="lazy" />
						</div>
						<h3 class="service-title">Figma → Webflow</h3>
						<p class="service-text">
							Ваш макет стає робочим сайтом. Pixel-perfect верстка, повний адаптив під всі екрани і чиста структура класів — без компромісів і без зайвого коду. Результат виглядає рівно так, як задумано в дизайні.
						</p>
					</article>
					<article class="service-card">
						<div class="service-icon-slot" aria-hidden="true">
							<img class="service-icon-image" src="/images/icon/Code%20%281%29%201.svg" alt="" loading="lazy" />
						</div>
						<h3 class="service-title">Кастомна розробка</h3>
						<p class="service-text">
							Жодних шаблонів. Кожен блок зібраний під вашу задачу з нуля — з анімаціями, взаємодіями і CMS там, де це дійсно потрібно. Сайт працює на ваш бізнес, а не виглядає як черговий клон.
						</p>
					</article>
					<article class="service-card">
						<div class="service-icon-slot" aria-hidden="true">
							<img class="service-icon-image" src="/images/icon/seo.svg" alt="" loading="lazy" />
						</div>
						<h3 class="service-title">SEO on-page</h3>
						<p class="service-text">
							Мета-теги, заголовки, alt-тексти, sitemap, Open Graph і schema markup — повна базова SEO-структура з першого дня. Сайт одразу готовий до індексації й органічного трафіку без доробок.
						</p>
					</article>
					<article class="service-card">
						<div class="service-icon-slot" aria-hidden="true">
							<img class="service-icon-image" src="/images/icon/speed-optimization.svg" alt="" loading="lazy" />
						</div>
						<h3 class="service-title">Оптимізація швидкості</h3>
						<p class="service-text">
							Мінімум зайвих стилів, стиснуті зображення, оптимізований код і lazy load. Сайт вантажиться швидко на будь-якому пристрої — без милиць, плагінів і зайвих скриптів.
						</p>
					</article>
					<article class="service-card">
						<div class="service-icon-slot" aria-hidden="true">
							<img class="service-icon-image" src="/images/icon/Client-First.svg" alt="" loading="lazy" />
						</div>
						<h3 class="service-title">Client-First верстка</h3>
						<p class="service-text">
							Структура класів за методологією Client-First — індустріальний стандарт Webflow. Зрозуміло вам, зрозуміло будь-якому наступному розробнику. Сайт легко підтримувати і масштабувати роками.
						</p>
					</article>
					<article class="service-card">
						<div class="service-icon-slot" aria-hidden="true">
							<img class="service-icon-image" src="/images/icon/launch-and-scale.svg" alt="" loading="lazy" />
						</div>
						<h3 class="service-title">Запуск і масштабування</h3>
						<p class="service-text">
							Підключення домену, налаштування аналітики, дизайн-система і документація. Сайт повністю готовий до трафіку з першого дня і росте разом з вашим бізнесом без переробок.
						</p>
					</article>
						</div>
					</div>
				</div>
			</section>

			<section id="process" class="section process">
				<div class="section-pad">
					<div class="container">
						<div class="section-content">
				<h2>Як відбувається робота</h2>
				<p class="section-intro">
					Простий і передбачуваний процес без зайвих етапів. На кожному кроці ви розумієте, що
					відбувається і який наступний крок.
				</p>
				<div class="process-layout">
				<ol class="process-list">
					<li class="process-item is-active" data-step="1">
						<p class="process-step">Крок 1</p>
						<h3 class="process-title">Короткий бриф і уточнення задачі</h3>
						<p class="process-text">
							Ви описуєте цілі сайту, а я ставлю точні питання, щоб одразу зафіксувати обсяг роботи.
						</p>
					</li>
					<li class="process-item" data-step="2">
						<p class="process-step">Крок 2</p>
						<h3 class="process-title">Структура сторінки або сайту</h3>
						<p class="process-text">
							Погоджуємо логіку секцій, контентні блоки і порядок подачі, щоб сайт легко читався.
						</p>
					</li>
					<li class="process-item" data-step="3">
						<p class="process-step">Крок 3</p>
						<h3 class="process-title">Верстка у Webflow</h3>
						<p class="process-text">
							Збираю сайт по блоках з адаптивом і чистими стилями. Ви бачите проміжний прогрес.
						</p>
					</li>
					<li class="process-item" data-step="4">
						<p class="process-step">Крок 4</p>
						<h3 class="process-title">Фінальні правки і перевірка</h3>
						<p class="process-text">
							Вношу узгоджені правки, перевіряю базову SEO-структуру та загальну акуратність сторінок.
						</p>
					</li>
					<li class="process-item" data-step="5">
						<p class="process-step">Крок 5</p>
						<h3 class="process-title">Публікація і передача</h3>
						<p class="process-text">
							Підключаємо домен, запускаємо сайт і за потреби показую, як вносити зміни самостійно.
						</p>
					</li>
				</ol>
				<div class="process-preview">
					<div class="process-preview-frame" aria-live="polite">
						<div class="process-preview-panel is-active" data-step-panel="1">
							<img
								class="process-preview-image"
								src="/images/process/process-step-1-brief.png"
								alt="Крок 1: підготовка і бриф"
								loading="lazy"
							/>
						</div>
						<div class="process-preview-panel" data-step-panel="2">
							<img
								class="process-preview-image"
								src="/images/process/process-step-2-structure.png"
								alt="Крок 2: структура сайту"
								loading="lazy"
							/>
						</div>
						<div class="process-preview-panel" data-step-panel="3">
							<img
								class="process-preview-image"
								src="/images/process/process-step-3-build.png"
								alt="Крок 3: верстка у Webflow"
								loading="lazy"
							/>
						</div>
						<div class="process-preview-panel" data-step-panel="4">
							<img
								class="process-preview-image"
								src="/images/process/process-step-4-review-seo.png"
								alt="Крок 4: фінальні правки"
								loading="lazy"
							/>
						</div>
						<div class="process-preview-panel" data-step-panel="5">
							<img
								class="process-preview-image"
								src="/images/process/process-step-5-launch.png"
								alt="Крок 5: публікація і запуск"
								loading="lazy"
							/>
						</div>
					</div>
				</div>
				</div>
						</div>
					</div>
				</div>
			</section>

			<section id="about" class="section about">
				<div class="section-pad">
					<div class="container">
						<div class="section-content">
				<div class="about-layout">
					<div class="about-copy">
						<p class="about-kicker">Про мене</p>
						<h2 class="about-title">
							👋 Мене звати Станіслав, я Webflow Developer.
						</h2>
						<p class="about-lead">
							Працюю віддалено з клієнтами над сайтами, які швидко запускаються, зрозуміло презентують
							послуги і допомагають стабільно отримувати заявки.
						</p>
						<p class="about-lead">
							Беру на себе весь процес: структура, верстка в Webflow, базове SEO, передача і подальша
							підтримка без хаосу в комунікації.
						</p>
						<a href="#contact" class="btn btn-primary about-cta">Обговорити проєкт</a>
					</div>
					<div class="about-visual" aria-hidden="true">
						<div class="about-photo about-photo-wide">
							<img src="/images/projects/project-business.svg" alt="" class="about-visual-image" loading="lazy" />
						</div>
						<div class="about-photo about-photo-tall">
							<img src="/images/projects/project-cms.svg" alt="" class="about-visual-image" loading="lazy" />
						</div>
						<div class="about-photo about-photo-bottom">
							<img src="/images/projects/project-landing.svg" alt="" class="about-visual-image" loading="lazy" />
						</div>
					</div>
				</div>
					</div>
				</div>
			</section>

			<section id="blog" class="section blog">
				<div class="section-pad">
					<div class="container">
						<div class="section-content">
				<h2>Блог</h2>
				<p class="section-intro">
					Статті про Webflow, вибір формату сайту та підготовку до запуску — щоб ви розуміли
					процес ще до старту проєкту.
				</p>
				<div class="blog-grid">
					<article class="blog-card">
						<p class="blog-meta">Webflow • 6 хв читання</p>
						<h3 class="blog-title">Чому Webflow, а не WordPress для малого бізнесу</h3>
						<p class="blog-text">
							Просте порівняння платформ: коли Webflow дає перевагу, а коли краще обрати інший підхід.
						</p>
						<a href="#contact" class="blog-link">Читати статтю</a>
					</article>
					<article class="blog-card">
						<p class="blog-meta">Бюджет • 5 хв читання</p>
						<h3 class="blog-title">Скільки коштує сайт на Webflow у 2026 році</h3>
						<p class="blog-text">
							З чого складається ціна, як оцінити обсяг роботи і що впливає на фінальний бюджет.
						</p>
						<a href="#contact" class="blog-link">Читати статтю</a>
					</article>
					<article class="blog-card">
						<p class="blog-meta">Старт проєкту • 4 хв читання</p>
						<h3 class="blog-title">Що підготувати перед створенням сайту</h3>
						<p class="blog-text">
							Короткий список матеріалів, які економлять час на запуску і роблять процес передбачуваним.
						</p>
						<a href="#contact" class="blog-link">Читати статтю</a>
					</article>
				</div>
				<div class="blog-actions">
					<a href="#contact" class="btn btn-secondary">Всі статті</a>
				</div>
						</div>
					</div>
				</div>
			</section>

			<section id="contact" class="section contact">
				<div class="section-pad">
					<div class="container">
						<div class="section-content">
							<div class="contact-hero-shell">
								<div class="contact-hero-frame">
									<div class="contact-hero-bg">
										<div class="contact-layout">
											<div class="contact-copy">
												<h2 class="contact-title">Готові до запуску сайту без обмежень?</h2>
												<p class="contact-intro">Напишіть контакт і ваше ім'я - я повернусь з відповіддю протягом дня.</p>
												<div class="contact-quick-links">
													<a class="contact-telegram" href="https://t.me/username" target="_blank" rel="noreferrer" aria-label="Написати в Telegram">
														<svg viewBox="0 0 24 24" width="31" height="31" aria-hidden="true" focusable="false">
															<path fill="currentColor" d="M9.78 15.65 9.4 20.5c.54 0 .78-.23 1.07-.5l2.57-2.46 5.33 3.9c.98.55 1.67.26 1.93-.9L23.8 4.1h0c.31-1.45-.52-2.02-1.47-1.66L1.7 10.4c-1.4.55-1.37 1.33-.24 1.68l5.28 1.65L19 6.04c.58-.35 1.1-.16.66.22" />
														</svg>
													</a>
													<a class="contact-email" href="mailto:hello@example.com" aria-label="Написати на email">
														<svg viewBox="0 0 24 24" width="29" height="29" aria-hidden="true" focusable="false">
															<path fill="currentColor" d="M3 6.75A2.75 2.75 0 0 1 5.75 4h12.5A2.75 2.75 0 0 1 21 6.75v10.5A2.75 2.75 0 0 1 18.25 20H5.75A2.75 2.75 0 0 1 3 17.25V6.75Zm2.1-.25 6.46 5.16a.7.7 0 0 0 .88 0L18.9 6.5H5.1Zm13.9 1.79-5.68 4.54a2.1 2.1 0 0 1-2.64 0L5 8.29v8.96c0 .41.34.75.75.75h12.5c.41 0 .75-.34.75-.75V8.29Z" />
														</svg>
													</a>
												</div>
											</div>
											<form class="contact-form contact-form-modern" action="#" method="post">
												<div class="contact-field">
													<label for="contact-info">Email або Telegram</label>
													<input id="contact-info" name="contact" type="text" placeholder="you@email.com / @username" required />
												</div>
												<div class="contact-field">
													<label for="name">Ім'я</label>
													<input id="name" name="name" type="text" placeholder="Ваше ім'я" required />
												</div>
												<div class="contact-field contact-field-full contact-submit">
													<button type="submit" class="btn btn-primary">Надіслати запит</button>
												</div>
											</form>
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</section>
		</main>

		<footer class="footer">
			<div class="footer-inner container">
				<div class="footer-brand">
					<a href="#hero" class="footer-logo"><img src="/images/logo-large.svg" alt="Webflow Dev" width="196" height="17" /></a>
					<p class="footer-text">Розробка сайтів на Webflow для бізнесу, фаундерів та спеціалістів.</p>
				</div>

				<nav class="footer-nav" aria-label="Нижня навігація">
					<a href="#services">Послуги</a>
					<a href="#process">Процес</a>
					<a href="#work">Роботи</a>
					<a href="#blog">Блог</a>
					<a href="#contact">Контакт</a>
				</nav>

				<div class="footer-contacts">
					<a href="mailto:hello@example.com">hello@example.com</a>
					<a href="https://t.me/username" target="_blank" rel="noreferrer">Telegram</a>
					<a href="https://www.linkedin.com/" target="_blank" rel="noreferrer">LinkedIn</a>
				</div>

				<div class="footer-bottom">
					<p class="footer-copy">&copy; 2026 Webflow Dev. All rights reserved.</p>
					<div class="footer-langs" aria-label="Language switcher">
						<a href="/" class="is-active">UK</a>
						<span>/</span>
						<a href="/en/">EN</a>
					</div>
				</div>
			</div>
		</footer>

		<script>
			// Мобільне меню
			const menuToggle = document.getElementById('menu-toggle');
			const navList = document.getElementById('nav-list');
			const header = document.querySelector('.header');
			if (menuToggle && navList) {
				menuToggle.addEventListener('click', () => {
					const isOpen = navList.classList.contains('is-open');
					navList.classList.toggle('is-open');
					menuToggle.setAttribute('aria-label', isOpen ? 'Відкрити меню' : 'Закрити меню');
				});
			}

			const syncHeaderOnScroll = () => {
				if (!header) return;
				header.classList.toggle('is-scrolled', window.scrollY > 24);
			};

			syncHeaderOnScroll();
			window.addEventListener('scroll', syncHeaderOnScroll, { passive: true });

			const workTabs = document.querySelectorAll('.work-type[data-tab]');
			const workPanels = document.querySelectorAll('.work-preview-panel[data-panel]');
			if (workTabs.length && workPanels.length) {
				const tabs = Array.from(workTabs);
				const panels = Array.from(workPanels);
				const cycleMs = 5000;
				let activeIndex = Math.max(0, tabs.findIndex((item) => item.classList.contains('is-active')));
				let cycleStart = performance.now();

				const setProgress = (value) => {
					tabs.forEach((item, index) => {
						item.style.setProperty('--tab-progress', index === activeIndex ? String(value) : '0');
					});
				};

				const activateTab = (index, restartCycle = true) => {
					activeIndex = index;
					const activeTab = tabs[index];
					const key = activeTab.getAttribute('data-tab');
					if (!key) return;

					tabs.forEach((item) => {
						const active = item === activeTab;
						item.classList.toggle('is-active', active);
						item.setAttribute('aria-selected', active ? 'true' : 'false');
					});

					panels.forEach((panel) => {
						const active = panel.getAttribute('data-panel') === key;
						panel.classList.toggle('is-active', active);
					});

					if (restartCycle) {
						cycleStart = performance.now();
						setProgress(0);
					}
				};

				workTabs.forEach((tab) => {
					tab.addEventListener('click', () => {
						const index = tabs.indexOf(tab);
						if (index === -1) return;
						activateTab(index, true);
					});
				});

				activateTab(activeIndex, true);

				const animateTabs = (now) => {
					const elapsed = now - cycleStart;
					const ratio = Math.min(1, elapsed / cycleMs);
					setProgress(ratio);

					if (elapsed >= cycleMs) {
						const nextIndex = (activeIndex + 1) % tabs.length;
						activateTab(nextIndex, true);
					}

					requestAnimationFrame(animateTabs);
				};

				requestAnimationFrame(animateTabs);
			}

			const processItems = document.querySelectorAll('.process-item[data-step]');
			const processPanels = document.querySelectorAll('.process-preview-panel[data-step-panel]');
			if (processItems.length && processPanels.length) {
				const processSection = document.getElementById('process');
				const processPreview = document.querySelector('.process-preview');
				const items = Array.from(processItems);
				const panels = Array.from(processPanels);
				const firstPanel = panels[0];
				const lastPanel = panels[panels.length - 1];
				let activeStep = '1';
				const triggerRatio = 0.7; // switch when item reaches lower-mid viewport
				const startEdgeToggleOffset = 150; // px to scroll before start edge hide/show toggles
				const endEdgeToggleOffset = 450; // px to scroll before end edge hide/show toggles
				let lastScrollY = window.scrollY;
				let isStartHidden = true;
				let isEndHidden = false;

				if (processPreview) {
					processPreview.classList.add('is-start-hidden');
				}

				const setProcessStep = (step, direction = 'down') => {
					if (!step || step === activeStep) return;
					activeStep = step;

					items.forEach((item) => {
						const isActive = item.getAttribute('data-step') === step;
						item.classList.toggle('is-active', isActive);
					});

					panels.forEach((panel) => {
						const isActive = panel.getAttribute('data-step-panel') === step;
						panel.classList.toggle('is-active', isActive);
						panel.classList.remove('is-forward', 'is-reverse');
						if (isActive) {
							panel.classList.add(direction === 'up' ? 'is-reverse' : 'is-forward');
						}
					});
				};

				const triggerPanelReveal = (panel, direction) => {
					if (!panel) return;
					panel.classList.remove('is-forward', 'is-reverse');
					// Force animation restart when toggling hidden state
					void panel.offsetWidth;
					panel.classList.add(direction === 'up' ? 'is-reverse' : 'is-forward');
				};

				const syncEdgeProcessImageVisibility = (direction) => {
					if (!processSection || !processPreview) return;
					const sectionRect = processSection.getBoundingClientRect();
					const scrolledInsideSection = Math.max(0, -sectionRect.top);
					const scrolledPastSection = Math.max(0, window.innerHeight - sectionRect.bottom);
					const shouldHideStart = scrolledInsideSection < startEdgeToggleOffset;
					const shouldHideEnd = scrolledPastSection > endEdgeToggleOffset;

					if (shouldHideStart !== isStartHidden) {
						isStartHidden = shouldHideStart;
						processPreview.classList.toggle('is-start-hidden', shouldHideStart);
						if (!shouldHideStart) triggerPanelReveal(firstPanel, direction);
					}

					if (shouldHideEnd !== isEndHidden) {
						isEndHidden = shouldHideEnd;
						processPreview.classList.toggle('is-end-hidden', shouldHideEnd);
						if (!shouldHideEnd) triggerPanelReveal(lastPanel, direction);
					}
				};

				const updateStepOnScroll = () => {
					const currentScrollY = window.scrollY;
					const direction = currentScrollY < lastScrollY ? 'up' : 'down';
					lastScrollY = currentScrollY;
					syncEdgeProcessImageVisibility(direction);
					const viewportAnchor = window.innerHeight * triggerRatio;
					const lastItem = items[items.length - 1];

					// Lock to the 5th step exactly when it reaches viewport center.
					if (lastItem) {
						const lastRect = lastItem.getBoundingClientRect();
						if (lastRect.top <= viewportAnchor) {
							const lastStep = lastItem.getAttribute('data-step');
							if (lastStep) setProcessStep(lastStep, direction);
							return;
						}
					}

					let currentItem = items[0];
					items.forEach((item) => {
						const rect = item.getBoundingClientRect();
						if (rect.top <= viewportAnchor) currentItem = item;
					});

					const step = currentItem.getAttribute('data-step');
					if (step) setProcessStep(step, direction);
				};

				updateStepOnScroll();
				window.addEventListener('scroll', updateStepOnScroll, { passive: true });
				window.addEventListener('resize', updateStepOnScroll);
			}

		</script>
	</body>
